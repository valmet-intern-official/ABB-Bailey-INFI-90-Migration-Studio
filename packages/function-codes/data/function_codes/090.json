  "notes": [
    {
      "label": "1.",
      "text": "Maximum values are: 9,998 for the BRC-100, IMMFP11/12 31,998 for the HAC",
      "manual_page": 258,
      "context": "specifications"
    },
    {
      "label": "2.",
      "text": "Only the redundancy configuration flag and the module mode on I/O module trip selections are tunable.",
      "manual_page": 258,
      "context": "specifications"
    },
    {
      "label": "3.",
      "text": "I/O trip (function code 32) is applicable only to Harmony rack I/O modules (expander bus).",
      "manual_page": 258,
      "context": "specifications"
    },
    {
      "label": "4.",
      "text": "Applies to the serial port on the controllers, not the SAC/DCS station link.",
      "manual_page": 258,
      "context": "specifications"
    },
    {
      "label": "5.",
      "text": "Modification of the I/O interface type out of expander bus only mode is not permitted unless the Harmony net hardware is installed properly.",
      "manual_page": 258,
      "context": "specifications"
    }
