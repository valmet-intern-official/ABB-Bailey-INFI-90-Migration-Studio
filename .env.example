# =============================================================================
# ABB Bailey INFI 90 Migration Studio — environment template
# Copy to .env.local for development. Never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC FRONTEND VARIABLES (safe to expose in the browser bundle)
# -----------------------------------------------------------------------------
# Origin of the Render-hosted API when the UI is on Vercel.
# Leave empty for same-origin (local dev, or single-host Render deploy).
NEXT_PUBLIC_API_BASE_URL=

# -----------------------------------------------------------------------------
# SERVER VARIABLES (Render web service)
# -----------------------------------------------------------------------------
NODE_ENV=production
SERVICE_NAME=infi90-migration-api
PORT=3000

# Absolute path for session/upload/artifact storage.
# On Render, mount a persistent disk and set this to the mount path (e.g. /data).
STORAGE_ROOT=

# Maximum upload size in megabytes (default 100)
MAX_UPLOAD_MB=100

# -----------------------------------------------------------------------------
# CORS / FRONTEND ORIGIN (Render)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed browser origins. Do NOT use * in production.
# Example: https://abb-bailey-infi-90-migration-studio.vercel.app
CORS_ORIGINS=
# Alias accepted by the app (single origin)
FRONTEND_ORIGIN=

# -----------------------------------------------------------------------------
# DATABASE / QUEUE
# -----------------------------------------------------------------------------
# This application uses an on-disk session store (JSON under STORAGE_ROOT).
# No DATABASE_URL or REDIS_URL is required for the current architecture.
# DATABASE_URL=
# REDIS_URL=

# -----------------------------------------------------------------------------
# AUTH
# -----------------------------------------------------------------------------
# No authentication is implemented in the current release.
# Session IDs are unguessable UUIDs; treat them as capability tokens.
